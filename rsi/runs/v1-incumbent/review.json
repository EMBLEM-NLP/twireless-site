          "path": "evidence/index-desktop.png",
          "sha256": "fc169694545c65045ea27d1ce38227e143c96ebe710ee32f5558b6611586eeff"
        }
      ]
    },
    "service_clarity": {
      "score": 2.5,
      "status": "reviewed",
      "rationale": "Phones, home services, repairs and switching are listed, but the Bell family is only named. Virgin Plus and Lucky Mobile get one line each, home services are three short cards, and there is no page explaining what each brand offers.",
      "evidence": [
        {
          "path": "evidence/index-phone.png",
          "sha256": "5ea21e29a8d56f7c096053f7bce7c8809833c73b545124eb68755b693ee6290f"
