          "sha256": "fc169694545c65045ea27d1ce38227e143c96ebe710ee32f5558b6611586eeff"
        }
      ]
    },
    "navigation_wayfinding": {
      "score": 3.5,
      "status": "reviewed",
      "rationale": "Clear five-item menu, footer links and a phone action bar. On phones the menu wraps to two lines, and there is no route to brand information.",
      "evidence": [
