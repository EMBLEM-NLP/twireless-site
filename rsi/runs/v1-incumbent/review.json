    "first_impression": {
      "score": 2.5,
      "status": "reviewed",
      "rationale": "Logo sign and scalloped awning read as a storefront, but the hero below is white text plus a store card. Nothing shows the shop, the phones or the Bell family, so the first screen looks like a generic template.",
      "evidence": [
        {
          "path": "evidence/index-phone.png",
