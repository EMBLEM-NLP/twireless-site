          "sha256": "fc169694545c65045ea27d1ce38227e143c96ebe710ee32f5558b6611586eeff"
        }
      ]
    },
    "visual_richness": {
      "score": 1.5,
      "status": "reviewed",
      "rationale": "Only line icons, the awning edge and two navy panels. No illustration, product imagery or colour fields on the inner pages; most of each page is white space and body text.",
      "evidence": [
        {
          "path": "evidence/index-phone.png",
          "sha256": "5ea21e29a8d56f7c096053f7bce7c8809833c73b545124eb68755b693ee6290f"
        },
